<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backcolor">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16sp"
            android:orientation="vertical">

            <!-- Imagen Logo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@drawable/logo2_erimsa"/>

            <!-- Titulo y SpAno -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"
                    style="@style/TextoTitulos"
                    android:text="Mis Vacaciones."/>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="12sp"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color">

                    <Spinner
                        android:id="@+id/spAnos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/sp_activo"
                        android:layout_gravity="center"/>

                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVacaciones"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                style="@style/Tarjeta_menu_personalizada"
                android:layout_marginBottom="24sp" />

            <!-- Linea -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12sp"
                android:background="@color/secundario"/>

            <!-- Textpo Introduccion Seleccion fechas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="Pulsa en los cuadros, para configurar fechas."/>

            <!-- Selectores de Fechas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18sp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFechaInicial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/gris_oscuro"
                            android:layout_marginBottom="4dp"
                            android:gravity="center"
                            android:text="Pulsa Inicio 📅"/>

                        <TextView
                            android:id="@+id/tvFechaInicio"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/selector_color_texto"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="--/--/----"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFechaFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/gris_oscuro"
                            android:layout_marginBottom="4dp"
                            android:gravity="center"
                            android:text="Pulsa Final 📅"/>

                        <TextView
                            android:id="@+id/tvFechaFinal"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/selector_color_texto"
                            android:textStyle="bold"
                            android:textSize="16dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="--/--/----"/>

                    </LinearLayout>


                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <!-- Boton Guardar -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/selector_btn_back_color"
                style="@style/TextoSp"
                android:text="Guardar Registro"/>

        </LinearLayout>

    </ScrollView>
    <!-- 2. UBICACIÓN CLAVE: El ProgressBar se añade al final de la jerarquía
         para que flote en el centro absoluto, tapando la pantalla al cargar -->
    <ProgressBar
        android:id="@+id/pbCargando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:elevation="8dp"
        android:theme="@style/Widget.AppCompat.ProgressBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

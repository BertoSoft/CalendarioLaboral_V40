<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backcolor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16sp"
        android:orientation="vertical">

        <!-- Imagen Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:src="@drawable/logo2"/>

        <!-- Texto Titulo y spAno -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                style="@style/TextoTitulos"
                android:text="Festivos del Año."/>

            <Spinner
                android:id="@+id/spAnos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center"/>

        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            style="@style/Tarjeta_menu_personalizada"
            android:layout_marginBottom="16sp"/>

        <!-- Selector de fecha y Tipo Festivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginBottom="24sp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginBottom="12dp"
                style="@style/Tarjeta_menu_personalizada"
                app:cardBackgroundColor="@color/sp_activo">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    style="@style/Texto"
                    android:textColor="@color/secundario"
                    android:text="Seleccionar Fecha 📅"
                    android:layout_weight="1"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/sp_activo"
                android:layout_marginBottom="12sp"
                style="@style/Tarjeta_menu_personalizada"
                android:layout_weight="1">

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

        <!-- Boton de Guardar -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:backgroundTint="@color/secundario"
            style="@style/TextoSp"
            android:text="Guardar Datos"/>

    </LinearLayout>

</ScrollView>
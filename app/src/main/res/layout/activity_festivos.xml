<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- Imagen Logo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:src="@drawable/logop1"
                android:contentDescription="Logo Erimsa"/>

            <!-- Texto Titulo y spAno -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    style="@style/TextoTitulos"
                    android:textSize="20sp"
                    android:text="Festivos del Año"/>

                <!-- CONTENEDOR SPINNER AÑO SANADO -->
                <!-- Selector de Año (Minimalista sin fondos forzados) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color"
                    app:cardElevation="4dp">

                    <Spinner
                        android:id="@+id/spAnos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="12dp"
                        android:gravity="center_vertical"
                        android:spinnerMode="dropdown"
                        style="@style/TextoSpAnos"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Título de sección para el listado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FESTIVOS REGISTRADOS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView dentro de tarjeta limpia -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                style="@style/Tarjeta_menu_personalizada"
                android:layout_marginBottom="16sp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFestivos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false"/>

            </androidx.cardview.widget.CardView>

            <!-- DIVISOR ESTILIZADO -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="16sp"/>
            <!-- SECCIÓN NUEVO REGISTRO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AÑADIR NUEVO FESTIVO"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.05" />

            <!-- Selector de fecha y Tipo Festivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Botón de fecha estilizado tipo input -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFecha"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    style="@style/Tarjeta_menu_personalizada">

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@color/primary_light"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:text="Seleccionar Fecha 📅"/>

                </androidx.cardview.widget.CardView>

                <!-- Selector de tipo de festivo (Minimalista sin fondo pesado) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSpFestivos"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16sp"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color"
                    app:cardElevation="0dp">

                    <Spinner
                        android:id="@+id/spFestivos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="12dp"
                        android:gravity="center_vertical"
                        android:spinnerMode="dropdown"/>
                    <!-- ⬆️ Mantiene la flecha nativa blanca brillante sin usar fondos extra -->

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Boton de Guardar Corporativo -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/selector_btn_back_color"
                android:textColor="@color/selector_color_texto_btn"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Guardar Registro"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ProgressBar de carga flotante -->
    <ProgressBar
        android:id="@+id/pbCargando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:elevation="8dp"
        style="?android:attr/progressBarStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollExcesosJornada"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA: TÍTULO Y FILTRO DE AÑO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE TIEMPOS"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />
                <TextView
                    android:id="@+id/tvTituloExcesos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excesos de Jornada"
                    style="@style/TextoTitulos"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.5"
                style="@style/Tarjeta_menu_personalizada">

                <Spinner
                    android:id="@+id/spAnos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/selector_spinner_back_color"
                    android:layout_gravity="center"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- SECCIÓN 1: DESGLOSE DE DÍAS FESTIVOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTEO DE JORNADAS Y FESTIVOS"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16sp"
            style="@style/Tarjeta_menu_personalizada">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Sábados -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sábados"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorSabados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Domingos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Domingos"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorDomingos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Festivos Nacionales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Festivos Nacionales"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorNacionales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Festivos Autonómicos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Festivos Autonómicos"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorAutonomicos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Festivos Locales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Festivos Locales"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorLocales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Festivo Convenio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Festivo Convenio (Sta. Bárbara)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorConvenio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0 días."/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 2: OTROS PARAMETROS GENERALES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CÁLCULO GENERAL Y MÉTRICAS"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16sp"
            style="@style/Tarjeta_menu_personalizada">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Horas laborables -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Totales"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorHoras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textAlignment="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0.0 h" />
                </LinearLayout>

                <!-- Vacaciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vacaciones"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorVacacionesExceso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        tools:text="0 días" />
                </LinearLayout>

                <!-- Horas Trabajo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laborables"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorTotales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <!-- Horas Exceso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Exceso"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvValorTotales1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <!-- Línea sutil de nota de pie -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="12dp"/>

                <!-- Resumen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nota:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tvValorResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:text="Todos los cómputos están actualizados según los registros locales introducidos." />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN INDICADOR FINAL DESTACADO (M3 Look) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResultadoExceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Tarjeta_menu_personalizada"
            app:cardBackgroundColor="@color/primary"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️"
                    android:textSize="32sp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvDiasExcesoFinal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Días de exceso: 0 días"
                        android:textColor="@color/text_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance de jornadas excedentes"
                        android:textColor="@color/text_on_primary"
                        android:alpha="0.8"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>


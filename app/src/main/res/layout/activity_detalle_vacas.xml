<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backcolor"
    tools:context=".modulos.detallevacas.ui.DetalleVacas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- Imagen logo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:src="@drawable/logo2_erimsa"/>




        </LinearLayout>

    </ScrollView>

    <!-- 2. UBICACIÓN CLAVE: El ProgressBar se añade al final de la jerarquía
         para que flote en el centro absoluto, tapando la pantalla al cargar -->

    <ProgressBar
        android:id="@+id/pbCargando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:elevation="8dp"
        android:theme="@style/Widget.AppCompat.ProgressBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
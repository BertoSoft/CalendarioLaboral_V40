<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backcolor"
    tools:context=".modulos.detallevacas.ui.DetalleVacas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- Imagen logo -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:src="@drawable/logo2_erimsa"/>

            <!-- Titulo y Spinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="18sp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    style="@style/TextoTitulos"
                    android:textSize="20dp"
                    android:text="Resumen Vacaciones"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/selector_spinner_back_color">

                    <Spinner
                        android:id="@+id/spAnos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/sp_activo"
                        android:layout_gravity="center"/>

                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <!-- Vacaciones años anteriores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    style="@style/Texto_16"
                    android:text="Vacaciones de años anteriores"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    style="@style/Tarjeta_menu_personalizada"
                    app:cardBackgroundColor="@color/primario">

                    <TextView
                        android:id="@+id/tvAtrasadas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/primario"
                        android:layout_gravity="center"/>

                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="360dp"
                style="@style/Tarjeta_menu_personalizada"
                android:padding="4dp"
                android:layout_marginBottom="36dp"
                android:background="@color/sp_activo">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVacaciones"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    style="@style/Tarjeta_menu_personalizada"
                    android:background="@color/sp_activo"/>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDisfrutadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Texto_16"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="Vacaciones Disfrutadas:\t\t\t6 Días."/>

                <TextView
                    android:id="@+id/tvPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Texto_16"
                    android:textStyle="bold"
                    android:text="Vacaciones Pendientes:\t\t\t36 Días."/>


            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 2. UBICACIÓN CLAVE: El ProgressBar se añade al final de la jerarquía
         para que flote en el centro absoluto, tapando la pantalla al cargar -->

    <ProgressBar
        android:id="@+id/pbCargando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:elevation="8dp"
        android:theme="@style/Widget.AppCompat.ProgressBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
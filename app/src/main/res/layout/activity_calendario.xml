<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    tools:context=".modulos.calendario.ui.Calendario">

    <ScrollView
        android:id="@+id/scrollCalendarioMensual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- CABECERA: TÍTULO Y SELECTORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <!-- Título Principal unificado -->
                <TextView
                    android:id="@+id/tvTituloCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CALENDARIO"
                    style="@style/TextoTitulos"
                    android:textAlignment="center"
                    android:layout_marginBottom="16dp" />

                <!-- Fila de Selectores (Spinners) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Spinner de Mes -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:layout_margin="4dp"
                        style="@style/Tarjeta_menu_personalizada"
                        app:cardBackgroundColor="@color/selector_spinner_back_color">

                        <Spinner
                            android:id="@+id/spMesCalendario"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"/>

                    </androidx.cardview.widget.CardView>


                    <!-- Spinner de Año -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        style="@style/Tarjeta_menu_personalizada"
                        app:cardBackgroundColor="@color/selector_spinner_back_color">

                        <Spinner
                            android:id="@+id/spAnioCalendario"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"/>

                    </androidx.cardview.widget.CardView>



                </LinearLayout>

            </LinearLayout>
            <!-- SECCIÓN DEL CALENDARIO DE MATRIZ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTRIBUCIÓN DE JORNADAS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <!--- Días de la semana -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:gravity="center" android:text="L"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:gravity="center" android:text="M"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:gravity="center" android:text="X"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:gravity="center" android:text="J"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:gravity="center" android:text="V"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:textColor="@color/cal_weekend_text" android:gravity="center" android:text="S"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" style="@style/Texto_16N" android:textColor="@color/cal_weekend_text" android:gravity="center" android:text="D"/>

            </LinearLayout>

            <!-- Tarjeta Contenedora de la cuadrícula -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendarioDias"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/background_app"
                android:clipToPadding="false"/>

            <!-- DIVISOR ESTILIZADO -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />
            <!-- SECCIÓN LEYENDA DE COLORES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEYENDA DE COLORES Y FESTIVOS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.05" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Tarjeta_menu_personalizada">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Fila 1: Exceso de Jornada y Vacaciones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_exceso"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Exceso Jornada"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_vacaciones"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vacaciones"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 2: Festivos Nacionales y Autonómicos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_nacional"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Festivo Nacional"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_autonomico"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Festivo Autonómico"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 3: Festivos Locales y Convenio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_local"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Festivo Local"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/cal_convenio"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Festivo Convenio"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 4: Día Actual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="4dp"
                                app:cardBackgroundColor="@color/primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Día Actual (Hoy)"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/pbCargando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:elevation="8dp"
        style="?android:attr/progressBarStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

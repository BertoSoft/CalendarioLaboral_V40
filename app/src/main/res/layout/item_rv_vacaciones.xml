<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFestivos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/backcolor"
    android:layout_margin = "8dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Linear que contine los tres textos de Vacaciones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFechaInicio"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:padding="4dp"
                style="@style/Texto"
                android:textColor="@color/secundario"
                android:gravity="end|center_vertical"
                android:layout_weight="0.4"/>

            <TextView
                android:id="@+id/tvFechaFin"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                style="@style/Texto"
                android:textColor="@color/secundario"
                android:padding="4dp"
                android:gravity="end|center_vertical"
                android:layout_weight="0.4"/>

            <TextView
                android:id="@+id/tvDias"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                style="@style/Texto"
                android:textColor="@color/secundario"
                android:padding="4dp"
                android:gravity="end|center_vertical"
                android:layout_weight="0.4"/>

        </LinearLayout>

        <!-- Botón de Papelera Estilizado y Minimalista -->
        <ImageButton
            android:id="@+id/ivDelete"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:src="@drawable/ic_eliminar"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar festivo" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFestivos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/backcolor"
    android:padding="4dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <!-- Linear que contine los tres textos de Vacaciones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    style="@style/Texto"
                    android:text="Desde el:"/>

                <TextView
                    android:id="@+id/tvFechaInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    style="@style/Texto"
                    android:gravity="end|center_vertical"
                    android:layout_weight="0.4"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    style="@style/Texto"
                    android:text="Hasta el:"/>

                <TextView
                    android:id="@+id/tvFechaFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Texto"
                    android:padding="4dp"
                    android:gravity="end|center_vertical"
                    android:layout_weight="0.4"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    style="@style/Texto"
                    android:text="Días: "/>

                <TextView
                    android:id="@+id/tvDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Texto"
                    android:padding="4dp"
                    android:gravity="end|center_vertical"
                    android:layout_weight="0.4"/>

            </LinearLayout>


        </LinearLayout>

        <!-- Botón de Papelera Estilizado y Minimalista -->
        <ImageButton
            android:id="@+id/ivDelete"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_eliminar"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar festivo" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
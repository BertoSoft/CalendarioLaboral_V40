<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/cardFestivos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Tarjeta_Rv">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Contenedor vertical para apilar los textos con alineación natural a la izquierda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <!-- Fecha de Inicio (Texto Principal Destacado) -->
            <TextView
                android:id="@+id/tvFechaInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Texto_16"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text = "Del 1 de agoasto de 3093"
                android:gravity="start|center_vertical"/>

            <!-- Fecha de Fin (Texto Secundario) -->
            <TextView
                android:id="@+id/tvFechaFin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Texto"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"
                tools:text = "al 23 de septiembred de 2026"
                android:gravity="start|center_vertical"/>

            <!-- Total de Días (Texto Informativo Adicional) -->
            <TextView
                android:id="@+id/tvDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Texto"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                tools:text = "Dias totales 22 dias."
                android:gravity="end|center_vertical"/>

        </LinearLayout>

        <!-- Botón de Papelera Estilizado con color de alerta sutil -->
        <ImageButton
            android:id="@+id/ivDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eliminar"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@color/warning"
            android:contentDescription="Eliminar período de vacaciones" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
